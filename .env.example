# =================================================================
# .env.example — copy this file to ".env" and fill in your own values.
# ".env" is git-ignored. NEVER commit real values.
# Every variable is explained in docs/00-setup-guide.md.
# =================================================================

# ---- App ---------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# Where the SQLite database (idempotency keys, failed records) lives
DATABASE_PATH=./data/o2c.db

# ---- Shopify (Dev Dashboard app + development store) -------------
# Store subdomain only, e.g. "glow-and-grace-dev" (NOT the full .myshopify.com URL)
SHOPIFY_STORE=
# Latest stable Admin API version at time of writing (check shopify.dev/docs/api/usage/versioning)
SHOPIFY_API_VERSION=2026-10
# From Dev Dashboard > your app > Settings
SHOPIFY_CLIENT_ID=
# The client secret is also the key Shopify uses to sign webhooks (HMAC check)
SHOPIFY_CLIENT_SECRET=

# ---- HubSpot (free CRM) ------------------------------------------
HUBSPOT_BASE_URL=https://api.hubapi.com
# Service key from Development > Keys > Service keys (sent as "Authorization: Bearer ...")
HUBSPOT_SERVICE_KEY=

# ---- Zoho Books (India data centre) ------------------------------
# India accounts server and API base. Change only if your Zoho Books URL is not books.zoho.in
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE=https://www.zohoapis.in/books/v3
# From the Zoho API Console > Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Long-lived token; the app uses it to get a new 1-hour access token when needed
ZOHO_REFRESH_TOKEN=
# From GET /organizations or Zoho Books > Manage Organizations
ZOHO_ORGANIZATION_ID=

# ---- Alerts (optional, used from Phase 5) ------------------------
# Slack incoming-webhook URL for success/failure alerts. Treat it as a secret.
SLACK_WEBHOOK_URL=
